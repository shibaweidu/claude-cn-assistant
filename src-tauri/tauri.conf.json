{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude 中文助手",
  "version": "0.1.1",
  "identifier": "community.claudecn.assistant",
  "build": { "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build", "devUrl": "http://127.0.0.1:4173", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "Claude 中文助手", "width": 1220, "height": 900, "minWidth": 900, "minHeight": 680 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'" }
  },
  "bundle": { "active": false, "targets": ["nsis"], "icon": ["icons/icon.ico"] }
}
